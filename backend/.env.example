# サーバー設定
PORT=4000
NODE_ENV=development

# フロントエンドのURL（CORSで許可するオリジン）
FRONTEND_URL=http://localhost:3000

# PostgreSQL接続文字列
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio_db?schema=public"

# Firebase Admin SDK（取得方法: Firebase Console > プロジェクト設定 > サービスアカウント > 新しい秘密鍵の生成）
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# セッションCookieの署名シークレット
SESSION_SECRET=your-strong-random-secret-here

# 画像保存先（"local" or "s3"）
IMAGE_STORAGE=local
# AWS S3設定（IMAGE_STORAGE=s3 の場合のみ必要）
# AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=your-bucket-name

# メール通知設定（Nodemailer）
# 未設定の場合はメール送信をスキップ（開発環境ではコメントアウトのままでOK）
# Gmailの場合: SMTP_USER にGmailアドレス、SMTP_PASS にアプリパスワードを設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@example.com
